nano .env.example
```

# Seguridad - CAMBIAR TODOS LOS VALORES EN PRODUCCIÓN
JWT_SECRET=cambiar_por_secreto_generado_con_openssl
SESSION_SECRET=cambiar_por_otro_secreto_diferente

# Entorno
NODE_ENV=development

# Base de datos
DB_NAME=gestion_ido.db

# CORS (separar por comas si hay múltiples)
ALLOWED_ORIGINS=http://localhost:3000

# Uploads (en bytes, 10MB por defecto)
MAX_FILE_SIZE=10485760

# Puerto
PORT=3000

# Instrucciones:
# 1. Copiar este archivo a .env
# 2. Generar secretos seguros con: openssl rand -base64 32
# 3. Nunca subir el archivo .env a Git
